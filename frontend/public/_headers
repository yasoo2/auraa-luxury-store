# Cloudflare Pages Headers Configuration

# Security headers for all pages
#
# Cache-Control is here too, and deliberately first: every rule below overrides
# it for the hashed assets, so what is left holding "no-cache" is the HTML.
# That matters because the /*.html rule further down never matched a single
# page of this shop — the browser asks for /products and /admin/orders, paths
# with no .html on the end, which the SPA rewrite turns into index.html only
# *after* header matching. So the shell was cacheable, and a shell held in the
# browser's HTTP cache keeps naming a bundle hash that the next deploy deleted:
# a white page that survives clearing Cache Storage, unregistering the service
# worker, and reloading, because none of those touch the HTTP cache.
/*
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache headers for static assets
/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
  
/*.css
  Cache-Control: public, max-age=31536000, immutable
  
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# The brand mark is NOT immutable: it lives at a fixed URL and the owner
# changes it. The year-long rule above froze the old orange "A" in every
# browser and edge cache — the new pendant logo deployed and nobody saw it.
# Later rules override earlier ones for the same header on Cloudflare Pages.
/favicon.svg
  Cache-Control: public, max-age=300, must-revalidate
  
/*.png
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# No cache for HTML and service worker
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
